GENERATION_BACKEND=OLLAMA
EMBEDDING_BACKEND=OLLAMA
CLASSIFIER_MODEL_ID=phi3:mini
GENERATION_MODEL_ID=qwen2.5:7b
EMBEDDING_MODEL_ID=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemini Developer API (google-genai). Alternatively set GOOGLE_API_KEY.
GEMINI_API_KEY=
# Models for GEMINI backend (examples: gemini-2.5-flash, gemini-embedding-001)
# GENERATION_MODEL_ID=gemini-2.5-flash
# EMBEDDING_MODEL_ID=gemini-embedding-001
# Vertex AI (optional — when GOOGLE_CLOUD_PROJECT is set, API key is ignored for Gemini)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

POSTGRES_HOST=localhost
# Docker dev compose maps Postgres to host 15432 (avoids local :5432 and Windows reserved ranges)
POSTGRES_PORT=15432
POSTGRES_DB=socratic_tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=changeme

REDIS_URL=redis://127.0.0.1:6379/0

CHROMA_HOST=localhost
CHROMA_PORT=8001

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:24678

# Logging: LOG_LEVEL=DEBUG for verbose backend logs; SQLALCHEMY_ECHO=true to print SQL
# LOG_LEVEL=INFO
# SQLALCHEMY_ECHO=false

# Optional LangChain / LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=socratic-tutor
