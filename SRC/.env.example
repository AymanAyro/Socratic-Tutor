# Ollama-only example:
# GENERATION_BACKEND=OLLAMA
# CLASSIFIER_MODEL_ID=phi3:mini
# GENERATION_MODEL_ID=qwen2.5:7b
# EMBEDDING_MODEL_ID=nomic-embed-text

# Gemini generation (API key from https://aistudio.google.com/apikey). Model ids must match AI Studio.
GENERATION_BACKEND=GEMINI
GENERATION_MODEL_ID=gemini-2.5-flash
# When GENERATION_BACKEND=GEMINI, classifier/guard use Google too — pick a valid Gemini id (flash is cheaper).
CLASSIFIER_MODEL_ID=gemini-2.5-flash

EMBEDDING_BACKEND=OLLAMA
EMBEDDING_MODEL_ID=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434

GEMINI_API_KEY=
# Same as GEMINI_API_KEY (either works).
# GOOGLE_API_KEY=
# Vertex AI (optional — when GOOGLE_CLOUD_PROJECT is set, API key is ignored for Gemini)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Gemini “thinking” / internal reasoning tokens (ignored when GENERATION_BACKEND=OLLAMA).
# Default 0 turns thinking off on 2.5 Flash / Flash-Lite (lower latency). Use -1 for API default (dynamic).
# 2.5 Pro cannot fully disable thinking; if requests fail with budget=0, set GEMINI_THINKING_BUDGET=-1 or use Flash.
# GEMINI_THINKING_BUDGET=-1
# Gemini 3+ uses level instead of budget (if set, GEMINI_THINKING_BUDGET is not sent): minimal | low | medium | high
# GEMINI_THINKING_LEVEL=
# Generation hyperparameters (applied to Ollama + Gemini chat models).
# LLM_TEMPERATURE=0.3
# LLM_TOP_P=0.9
# LLM_TOP_K=40
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_REPEAT_PENALTY=1.05

POSTGRES_HOST=localhost
# Docker dev compose maps Postgres to host 15432 (avoids local :5432 and Windows reserved ranges)
POSTGRES_PORT=15432
POSTGRES_DB=socratic_tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=changeme

REDIS_URL=redis://127.0.0.1:6379/0

CHROMA_HOST=localhost
CHROMA_PORT=8001

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:24678

# Logging: LOG_LEVEL=DEBUG for verbose backend logs; SQLALCHEMY_ECHO=true to print SQL
# LOG_LEVEL=INFO
# WARNING or ERROR hides startup/app INFO logs; per-request -> / <- still print (logger socratic.access).
# Shell environment overrides values here (e.g. LOG_LEVEL=WARNING in User env wins over this file).
# SQLALCHEMY_ECHO=false
#
# If curl hits :8000 but this terminal stays quiet: another process may own :8000, or the IDE
# may hide reload-child output — check SRC/access.log (updated on each request) or
# `docker compose logs -f fastapi` if the API runs in Docker.

# Optional LangChain / LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=socratic-tutor

# Stage 2 — phased teaching (LangGraph). Set ENABLE_STAGE2_GRAPH=true to default new sessions to Stage 2 from the API when use_stage2 is omitted (client still passes use_stage2:true from UI).
# ENABLE_STAGE2_GRAPH=false
# LANGGRAPH_CHECKPOINT_BACKEND=postgres
# LANGGRAPH_CHECKPOINT_BACKEND=memory
# LangGraph Postgres pool: TCP keepalives + shorter idle recycle (helps Windows 10053 / Docker NAT drops).
# LANGGRAPH_CHECKPOINT_TCP_KEEPALIVE=true
# LANGGRAPH_CHECKPOINT_KEEPALIVES_IDLE=30
# LANGGRAPH_CHECKPOINT_KEEPALIVES_INTERVAL=10
# LANGGRAPH_CHECKPOINT_KEEPALIVES_COUNT=3
# Set to 0 to use psycopg_pool default max_idle (600s).
# LANGGRAPH_CHECKPOINT_POOL_MAX_IDLE_SECONDS=180
# Minimum student probe answers before mastery can auto-advance to reveal (early /reveal uses the same floor).
# MIN_PROBE_TURNS=3
# MAX_PROBE_TURNS_DEFAULT=5
# MASTERY_CONFIDENCE_THRESHOLD=0.85
# REVEAL_POLL_TIMEOUT_SECONDS=10
# REVEAL_POLL_INTERVAL_SECONDS=0.5
# REPORT_OUTPUT_DIR=reports
# REPORT_TEMPLATE_DIR=templates/report
# PDF_GENERATION_TIMEOUT_SECONDS=30
# MERMAID_RENDER_TIMEOUT_SECONDS=10
# MERMAID_FALLBACK_ON_ERROR=true
